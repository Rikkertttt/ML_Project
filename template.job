#!/bin/bash

#SBATCH --partition=genoa
#SBATCH --gpus=0
#SBATCH --job-name=ML_ATLAS
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=01:00:00
#SBATCH --output=slurm_output_%A.out

module purge

export OMP_NUM_THREADS=9

cd $HOME/ML_Project/
# Activate your environment
source ~/ml_env/bin/activate
# Run your code
srun python main.py